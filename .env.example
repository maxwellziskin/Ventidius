# Flightwatch environment configuration
# Copy this to .env and fill in your values
# NEVER commit .env to version control

# ── Gmail API ────────────────────────────────────────────────────────────────
# Path to your downloaded OAuth2 client secret JSON from Google Cloud Console
GMAIL_CLIENT_SECRET_PATH=/home/user/Ventidius/client_secret.json

# Path where the OAuth token will be stored after first authentication
# This file will be created automatically on first run
GMAIL_CREDENTIALS_PATH=/home/user/Ventidius/token_gmail.json

# ── Notifications ─────────────────────────────────────────────────────────────
# Choose "pushover" or "telegram"
NOTIFICATION_CHANNEL=pushover

# Pushover (https://pushover.net) — recommended for personal use
PUSHOVER_API_TOKEN=your_pushover_application_token_here
PUSHOVER_USER_KEY=your_pushover_user_key_here

# Telegram (alternative)
# Create a bot via @BotFather, get the token and your chat ID
TELEGRAM_BOT_TOKEN=your_telegram_bot_token_here
TELEGRAM_CHAT_ID=your_telegram_chat_id_here

# ── Database ──────────────────────────────────────────────────────────────────
# Optional: override default SQLite path (default: data/flightwatch.sqlite)
# FLIGHTWATCH_DB_PATH=/home/user/Ventidius/data/flightwatch.sqlite
