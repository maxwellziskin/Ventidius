# Ziskin Field Systems - Cloud Platform Environment Variables

# Application
DEBUG=false
SECRET_KEY=change-this-to-a-secure-random-string
API_BASE_URL=https://api.zfs.example.com

# Database
DATABASE_URL=postgresql+asyncpg://postgres:postgres@db:5432/zfs

# Clerk Authentication
CLERK_SECRET_KEY=sk_live_xxxxx
CLERK_PUBLISHABLE_KEY=pk_live_xxxxx
CLERK_WEBHOOK_SECRET=whsec_xxxxx

# Email (Resend)
RESEND_API_KEY=re_xxxxx
EMAIL_FROM=alerts@zfs.example.com

# WireGuard
WIREGUARD_INTERFACE=wg0
WIREGUARD_PORT=51820
WIREGUARD_NETWORK=10.100.0.0/24

# Frontend (for Vite)
VITE_CLERK_PUBLISHABLE_KEY=pk_live_xxxxx
VITE_API_URL=http://localhost:8000
